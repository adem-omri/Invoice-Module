<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A4 / Portrait. Left & right margins follow the brief (10mm), top is
        kept minimal so the branded header band (rendered at the top of the
        article body) sits near the page edge. The bottom margin hosts the
        repeating footer band, which carries the real "Page X of Y" counter
        through wkhtmltopdf's footer region. -->
    <record id="paperformat_custom_invoice" model="report.paperformat">
        <field name="name">Custom Invoice A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">6</field>
        <field name="margin_bottom">26</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>
</odoo>
